# data + results (regenerable)
data/raw/*
data/processed/*
data/.cache/
!data/raw/.gitkeep
!data/processed/.gitkeep
# Hand-curated Higgins CSVs are NOT regenerable from a download; track them.
!data/raw/higgins_jan2025.csv
!data/raw/higgins_dec2025.csv
!data/raw/higgins_dec2025_build.py
# Track the small processed parquets so reviewers can inspect what the
# pipeline produces without having to run it. Tox21 parquet (208 KB) is
# excluded because it's auto-downloaded from the DeepChem mirror.
!data/processed/audit.json
!data/processed/long.parquet
!data/processed/dolmen.parquet
!data/processed/higgins_jan2025.parquet
!data/processed/higgins_dec2025.parquet
!data/processed/higgins_mixtures.parquet
!data/processed/fda_iid_candidates.parquet
# Track key processed artifacts so a reviewer can inspect what was built
# without running the pipeline first. These are small parquets / JSONs, not
# the bulky FDA/Tox21 downloads which still get regenerated on first run.
!data/processed/audit.json
!data/processed/long.parquet
!data/processed/higgins_jan2025.parquet
!data/processed/higgins_dec2025.parquet
!data/processed/higgins_mixtures.parquet
!data/processed/dolmen.parquet
results/figures/*
results/candidates/*
!results/figures/.gitkeep
!results/candidates/.gitkeep
# Track the README figures so GitHub renders them inline
!results/figures/spearman_summary.png
!results/figures/pareto_2d_top20.png
!results/figures/pareto_3d_chemberta.png
# Track the candidate output so reviewers can inspect without running
!results/candidates/top20.csv
!results/candidates/all_scored.csv
results/summary.json
results/results_table.csv
results.zip

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# model artifacts
*.pt
*.ckpt
*.bin
*.safetensors
checkpoints/

# misc
.DS_Store
.env
.venv/
venv/
wandb/
mlruns/
